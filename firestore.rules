rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // A signed-in user whose own profile is not marked blocked.
    function isNotBlocked() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'blocked';
    }

    // Profile docs. The owner may create/read their own profile WITHOUT email
    // verification so signup can bootstrap it. Admins can read all profiles and
    // update them (e.g. change status). No one may delete except an admin.
    //
    // Owners may update their own profile (e.g. displayName) but must NOT be
    // able to change their own `role` or `status` — only an admin can. This
    // prevents privilege escalation and self-unblocking.
    match /users/{uid} {
      allow read:   if request.auth.uid == uid || isAdmin();
      allow create: if request.auth.uid == uid || isAdmin();
      allow update: if isAdmin()
        || (request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin();
    }

    // Application data. Requires a VERIFIED email and a non-blocked account.
    // Admins keep full access for the dashboard / user management.
    match /cvs/{uid} {
      allow read, write: if (request.auth.uid == uid && isVerified() && isNotBlocked())
        || isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
